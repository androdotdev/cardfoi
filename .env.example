# Neon pooled connection string used by the Next.js app at runtime.
DATABASE_URL_POOLER="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Neon direct (unpooled) connection string used only by Drizzle migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require"

# Better Auth
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Local Next.js dev sets NODE_ENV=development automatically.
# Vercel sets VERCEL_ENV=production or preview for deployments when system env vars are exposed.
# Do not set NODE_ENV manually for Vercel deployments.

# OAuth credentials for prod only
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ImageKit (private key is server-only; never expose it with a NEXT_PUBLIC_ prefix)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# QStash (for local development, use the values printed by `qstash dev`)
QSTASH_URL="http://localhost:8080"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# APP url
APP_URL="you-app.com"
